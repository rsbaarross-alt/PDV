# ==============================================================================
# VARIÁVEIS DE AMBIENTE — PDV INTELIGENTE v2.0
# Copie este arquivo para .env no ambiente de desenvolvimento local
# No painel da Vercel: Project Settings -> Environment Variables
# ==============================================================================

# SUPABASE — Credenciais do Projeto (Obrigatório para sincronização em nuvem)
# Obtenha em: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_ANON_KEY="sua-chave-anon-publica"

# Chave secreta de serviço (Opcional, recomendada para o backend ter acesso irrestrito)
SUPABASE_SERVICE_ROLE_KEY=

# Variáveis Client-Side para Vite (Opcional, caso queira acesso direto pelo frontend)
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_ANON_KEY="sua-chave-anon-publica"

# AI Studio & Configurações adicionais
GEMINI_API_KEY=
APP_URL=
